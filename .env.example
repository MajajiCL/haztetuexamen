# =================================================================
# HAZTETUEXAMEN.CL — Environment Configuration
# =================================================================
# COPY THIS FILE TO `.env.local` AND FILL IN REAL VALUES
# NEVER COMMIT `.env.local` TO GIT
# =================================================================

# --- Google AI (Gemini + Imagen 4) ---
# Get from: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=tu_api_key_aqui

# --- Database ---
# Dev: SQLite (no setup required)
DATABASE_URL="file:./prisma/dev.db"
# Prod: PostgreSQL (descomenta y configura al deploy)
# DATABASE_URL="postgresql://user:password@45.239.218.16:5432/haztetuexamen?schema=public"

# --- Encryption (Ley 21.719 — datos sensibles AES-256) ---
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace_with_32byte_base64_key
ENCRYPTION_IV=replace_with_16byte_base64_iv

# --- Médico Colaborador (RNPI obligatorio Ley 21.746) ---
DOCTOR_NAME="Dr. [Nombre Apellido]"
DOCTOR_RUT="12345678-9"
DOCTOR_RNPI_REGISTRY="000000"
DOCTOR_SPECIALTY="Medicina General"
DOCTOR_DIGITAL_SIGNATURE_PATH="./secrets/doctor-signature.png"

# --- Transbank Webpay (modo pruebas inicialmente) ---
# Sandbox docs: https://www.transbankdevelopers.cl/documentacion/webpay-plus
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_ENVIRONMENT=integration

# --- Email (envío de órdenes PDF) ---
# Recomendado: Resend.com (free tier 3000/mes)
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM="ordenes@haztetuexamen.cl"

# --- App URLs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- ClaveÚnica (opcional — Fase 2) ---
CLAVEUNICA_CLIENT_ID=
