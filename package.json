{
  "name": "haztetuexamen",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce médico chileno con interfaz 3D inmersiva. Emisión digital de órdenes de exámenes preventivos con cumplimiento Ley 20.584 / 19.628 / 21.719 / 19.799.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@haztetuexamen/web",
    "dev:web": "npm run dev --workspace=@haztetuexamen/web",
    "dev:api": "npm run start:dev --workspace=@haztetuexamen/api",
    "dev:all": "concurrently -n web,api -c blue,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@haztetuexamen/web",
    "build:api": "npm run build --workspace=@haztetuexamen/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "generate:assets": "node scripts/generate-brand-assets.mjs",
    "generate:catalog-images": "node scripts/generate-catalog-images.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "MajajiCL",
  "license": "UNLICENSED"
}
